
# Copy this file to .env and fill in real values.
# .env is never committed.

APP_NAME=nyayasetu
APP_ENV=local
LOG_LEVEL=INFO
DATA_FILE=data/sample_records.json

# Neon PostgreSQL connection string goes in .env only.
DATABASE_URL=postgresql://localhost:5432/nyayasetu

# LLM keys (Day 8). Real values belong in .env and Render only.
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_PRIMARY_MODEL=gemini-3.6-flash
LLM_FALLBACK_MODEL=openai/gpt-oss-20b

# Queue and worker (Day 10). On your laptop Redis comes from: docker compose up -d redis
REDIS_URL=redis://localhost:6379
# Long random token required in the X-Admin-Token header to start ingestion.
ADMIN_TOKEN=
# true only where there is no separate worker service (Render free).
WORKER_IN_API=false
